# ---------------------------------------------------------------------------
# SportX environment
#
# Copy to .env.local and fill in what you have. The app runs with NONE of these
# set - it falls back to the keyless data tier and disables the features that
# genuinely cannot work without a key. It never substitutes invented data.
# ---------------------------------------------------------------------------

# Full league tables, complete fixture lists, and all player analytics.
# Free tier, ~2 minute signup: https://www.football-data.org/client/register
# Without it: tables fall back to TheSportsDB and are capped at 5 rows,
# and the /scorers page explains that it needs this key.
FOOTBALL_DATA_API_KEY=

# The natural-language assistant on /ask.
# Free key: https://aistudio.google.com/apikey
# Without it: the assistant is hidden rather than answering from guesswork.
GEMINI_API_KEY=

# TheSportsDB. "3" is their public free-tier key and needs no signup, so this
# only needs setting if you have a paid key and want the higher row limits.
SPORTSDB_API_KEY=3
